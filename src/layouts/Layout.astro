---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title,
  description = 'Pune Animal Liberation — Fighting for the rights of all animals in Pune, India.',
  image = '/images/og-default.jpg',
  type = 'website',
  canonical = Astro.url.pathname,
} = Astro.props;

const siteUrl = 'https://puneanimalliberation.com';
const fullUrl = `${siteUrl}${canonical}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-optimized.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Resource Hints -->
    <link rel="preconnect" href="https://comments.puneanimalliberation.com" crossorigin />
    <link rel="dns-prefetch" href="//comments.puneanimalliberation.com" />
    
    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />
    
    <!-- Open Graph Tags -->
    <meta property="og:title" content={`${title} | Pune Animal Liberation`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:site_name" content="Pune Animal Liberation" />
    <meta property="og:locale" content="en_IN" />
    
    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Pune Animal Liberation`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Pune Animal Liberation" />
    <meta name="keywords" content="animal rights, veganism, animal liberation, Pune, India, activism, animal welfare" />
    
    <title>{title} | Pune Animal Liberation</title>

    <!-- Umami Analytics -->
    <script
      defer
      src="https://analytics.greenfit.in/script.js"
      data-website-id="338cb98a-f616-4b20-b1e3-52070be1aab9"
    ></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <!-- Load analytics script after user interaction or delay -->
    <script>
      let loaded = false;
      const loadScript = () => {
        if (loaded) return;
        loaded = true;
        const script = document.createElement('script');
        script.src = 'https://comments.puneanimalliberation.com/web/counter.js';
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
      };

      // Load after 5 seconds of inactivity or on user interaction
      const timeoutId = setTimeout(loadScript, 5000);
      
      // Load immediately on any user interaction (click, scroll, etc.)
      ['click', 'scroll', 'keydown', 'mousemove'].forEach(event => {
        document.addEventListener(event, loadScript, { once: true });
      });
      
      // Also load when user might leave
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') loadScript();
      });
    </script>
  </body>
</html>
