---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { eventUrl, isPastEvent, isPublicEvent, isUpcomingEvent, sortByDateAscending, sortByDateDescending } from '../lib/events';

const events = await getCollection('events');
const publicEvents = events.filter(isPublicEvent);
const upcomingEvents = publicEvents.filter(isUpcomingEvent).sort(sortByDateAscending);
const pastEvents = publicEvents.filter(isPastEvent).sort(sortByDateDescending);
---

<Layout
  title="Events - Pune Animal Liberation"
  description="Join Pune Animal Liberation at our upcoming events, outreach, and activism in Pune, India."
  image="/images/og-events.jpg"
>
  <!-- Structured Data for Events Page -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Events - Pune Animal Liberation",
    "description": "Join Pune Animal Liberation at our upcoming events, outreach, and activism in Pune, India.",
    "url": "https://puneanimalliberation.com/events/",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": upcomingEvents.map((event, index) => ({
        "@type": "Event",
        "position": index + 1,
        "name": event.data.title,
        "startDate": event.data.date.toISOString(),
        "location": event.data.location ? {
          "@type": "Place",
          "name": event.data.location
        } : undefined,
        "url": `https://puneanimalliberation.com${eventUrl(event)}`,
        "organizer": {
          "@type": "Organization",
          "name": "Pune Animal Liberation",
          "url": "https://puneanimalliberation.com"
        }
      }))
    }
  }, null, 2)} />
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">Events</h1>
      <p class="page-header__subtitle">Upcoming activism, outreach, and recaps from our work</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <h2 class="section-heading">Upcoming Events</h2>
      {upcomingEvents.length > 0 ? (
        <div class="cards-grid">
          {upcomingEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              url={eventUrl(event)}
              status={event.data.status}
              coverImage={event.data.coverImage}
              coverImageAlt={event.data.coverImageAlt}
            />
          ))}
        </div>
      ) : (
        <p>No upcoming events. Check back soon.</p>
      )}

      <div class="section-divider"></div>
      <h2 class="section-heading">Past Events</h2>
      {pastEvents.length > 0 ? (
        <div class="cards-grid">
          {pastEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              url={eventUrl(event)}
              status={event.data.status}
              coverImage={event.data.coverImage}
              coverImageAlt={event.data.coverImageAlt}
            />
          ))}
        </div>
      ) : (
        <p>No past events yet.</p>
      )}
    </div>
  </section>
</Layout>
