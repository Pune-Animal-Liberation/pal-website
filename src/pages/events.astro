---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
const sortedEvents = events.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<Layout
  title="Events - Pune Animal Liberation"
  description="Join Pune Animal Liberation at our upcoming events, outreach, and activism in Pune, India."
  image="/images/og-events.jpg"
>
  <!-- Structured Data for Events Page -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Events - Pune Animal Liberation",
    "description": "Join Pune Animal Liberation at our upcoming events, outreach, and activism in Pune, India.",
    "url": "https://puneanimalliberation.com/events/",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": sortedEvents.map((event, index) => ({
        "@type": "Event",
        "position": index + 1,
        "name": event.data.title,
        "startDate": event.data.date.toISOString(),
        "location": event.data.location ? {
          "@type": "Place",
          "name": event.data.location
        } : undefined,
        "url": `https://puneanimalliberation.com/events/${event.data.slug ?? event.id}/`,
        "organizer": {
          "@type": "Organization",
          "name": "Pune Animal Liberation",
          "url": "https://puneanimalliberation.com"
        }
      }))
    }
  }, null, 2)} />
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">Events</h1>
      <p class="page-header__subtitle">Upcoming activism and outreach</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {sortedEvents.length > 0 ? (
        <div class="cards-grid">
          {sortedEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              url={`/events/${event.data.slug ?? event.id}/`}
            />
          ))}
        </div>
      ) : (
        <p>No upcoming events. Check back soon.</p>
      )}
    </div>
  </section>
</Layout>
