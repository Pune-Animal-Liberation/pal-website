---
export const prerender = false;

// If we are at /, check cookie
const preferredLang = Astro.cookies.get('preferred_lang')?.value;

// Redirect to preferred lang, or fallback to default 'en'
const targetLang = preferredLang && ['hi', 'mr'].includes(preferredLang) ? preferredLang : 'en';

return Astro.redirect(`/${targetLang}/`, 302);
