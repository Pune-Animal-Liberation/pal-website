---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const today = new Date();
today.setHours(0, 0, 0, 0);

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter((e) => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const stats = [
  { number: '100+', label: 'Street Outreaches' },
  { number: 'Thousands of', label: 'People Reached' },
  { number: 'Zero', label: 'Corporate Funding' },
  { number: 'NOW', label: 'Time to Act' }
];

const whatWeDoCards = [
  {
    title: 'Street Activism',
    description: 'We take to the streets with powerful messages, engaging the public in conversations about animal rights and veganism.'
  },
  {
    title: 'Peaceful Protests',
    description: 'Through peaceful demonstrations, we raise awareness about animal exploitation and demand systemic change.'
  },
  {
    title: 'Community Events',
    description: 'We organize events, workshops, and gatherings to build a strong, compassionate community in Pune.'
  }
];
---

<Layout
  title="Home"
  description="Pune Animal Liberation fights for the rights of all animals. Join our movement in Pune, India."
  image="/images/og-home.jpg"
>
  <!-- Structured Data for Organization -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Pune Animal Liberation",
    "url": "https://puneanimalliberation.com",
    "logo": "https://puneanimalliberation.com/images/logo.png",
    "description": "Pune Animal Liberation fights for the rights of all animals in Pune, India. Join our movement for animal rights and veganism.",
    "sameAs": [
      "https://puneanimalliberation.com"
    ],
    "areaServed": {
      "@type": "Place",
      "name": "Pune, India"
    },
    "knowsAbout": [
      "animal rights",
      "veganism",
      "animal welfare",
      "animal liberation",
      "activism"
    ]
  }, null, 2)} />
  <Hero
    title="STOP FUNDING <em>ANIMAL CRUELTY.</em>"
    subtitle="Join Pune Animal Liberation in the fight against animal exploitation. Every action counts in building a more compassionate world."
    ctaText="Take Action Now"
    ctaHref="/get-involved/"
  />

  <Stats stats={stats} />

  <WhatWeDo cards={whatWeDoCards} />

  <!-- Upcoming Events -->
  {upcomingEvents.length > 0 && (
    <section class="section" aria-labelledby="events-preview-heading">
      <div class="container">
        <h2 id="events-preview-heading" class="section-heading">Upcoming Events</h2>
        <div class="cards-grid">
          {upcomingEvents.map((event) => (
            <EventCard
              title={event.data.title}
              date={event.data.date}
              location={event.data.location}
              url={`/events/${event.data.slug ?? event.id}/`}
            />
          ))}
        </div>
        <div class="mt-md">
          <a href="/events/" class="btn btn--primary">View All Events</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="cta-heading">
    <div class="container">
      <h2 id="cta-heading">READY TO ACT?</h2>
      <p>
        Join us in the fight for animal liberation. Every voice matters, every action counts. Together we can create real change in Pune.
      </p>
      <a href="/get-involved/" class="btn">Join The Movement</a>
    </div>
  </section>
</Layout>
