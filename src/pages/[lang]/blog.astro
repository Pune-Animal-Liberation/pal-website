---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { languages } from '../../i18n/ui';
import { useTranslations, getPathWithLang } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);

const posts = await getCollection('blog');
const sortedPosts = posts
  .filter((post) => {
    const isCurrentLang = post.id.endsWith(`-${lang}.md`) || post.id.endsWith(`-${lang}.mdx`);
    const isDefaultLang = !post.id.includes('-hi.') && !post.id.includes('-mr.');
    if (lang === 'en') return isDefaultLang;
    if (isCurrentLang) return true;
    const hasTranslation = posts.some(p => p.id === post.id.replace(/\.md(x)?$/, `-${lang}.md$1`));
    return isDefaultLang && !hasTranslation;
  })
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout 
  title="Blog - Pune Animal Liberation" 
  description="Read the latest articles and updates from Pune Animal Liberation about animal rights, veganism, and activism in Pune, India."
  image="/images/og-blog.jpg"
>
  <!-- Structured Data for Blog Page -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Blog - Pune Animal Liberation",
    "description": "Read the latest articles and updates from Pune Animal Liberation about animal rights, veganism, and activism in Pune, India.",
    "url": "https://puneanimalliberation.com/blog/",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": sortedPosts.map((post, index) => ({
        "@type": "Article",
        "position": index + 1,
        "name": post.data.title,
        "url": `https://puneanimalliberation.com/blog/${post.data.slug ?? post.id}/`,
        "datePublished": post.data.date.toISOString(),
        "author": {
          "@type": "Organization",
          "name": "Pune Animal Liberation"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Pune Animal Liberation"
        }
      }))
    }
  }, null, 2)} />
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">Blog</h1>
      <p class="page-header__subtitle">Articles, updates, and reflections</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {sortedPosts.length > 0 ? (
        <div class="cards-grid">
          {sortedPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              date={post.data.date}
              author={post.data.author}
              thumbnail={post.data.thumbnail}
              thumbnailAlt={post.data.thumbnailAlt}
              url={getPathWithLang(`/blog/${post.data.slug ?? post.id}/`, lang as string)}
            />
          ))}
        </div>
      ) : (
        <p>No posts yet. Check back soon.</p>
      )}
    </div>
  </section>
</Layout>
