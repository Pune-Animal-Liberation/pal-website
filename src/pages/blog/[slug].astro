---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout 
  title={post.data.title}
  description={post.data.description || `Read ${post.data.title} by ${post.data.author || 'Pune Animal Liberation'}`}
  image={post.data.image}
  type="article"
>
  <!-- Structured Data for Article -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Pune Animal Liberation"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Pune Animal Liberation",
      "url": "https://puneanimalliberation.com"
    },
    "description": post.data.description || `Read ${post.data.title} by ${post.data.author || 'Pune Animal Liberation'}`,
    "image": post.data.image ? (post.data.image.startsWith('http') ? post.data.image : `https://puneanimalliberation.com${post.data.image}`) : undefined,
    "url": `https://puneanimalliberation.com${Astro.url.pathname}`,
    "mainEntityOfPage": `https://puneanimalliberation.com${Astro.url.pathname}`
  }, null, 2)} />
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">{post.data.title}</h1>
      <p class="page-header__subtitle">
        {formattedDate}
        {post.data.author && <span> &middot; {post.data.author}</span>}
      </p>
    </div>
  </div>

  <div class="post">
    {
      post.data.image && (
        <img src={post.data.image} alt={post.data.imageAlt || ''} class="post__cover" width="800" height="400" />
      )
    }

    <!-- Article content -->
    <div class="post__body">
      <Content />
    </div>

    <!-- Comment counter -->
    <a
      href="#remark42"
      class="remark42__counter"
      data-url={`https://puneanimalliberation.com${Astro.url.pathname}`}
      aria-label={`Comments on ${post.data.title}`}
    >
      Loading comments...
    </a>

    <!-- Comments -->
    <div id="remark42"></div>

    <script>
      // Only load comments if user interacts
      let commentsLoaded = false;
      
      function loadComments() {
        if (commentsLoaded) return;
        commentsLoaded = true;
        
        window.remark_config = {
          host: "https://comments.puneanimalliberation.com",
          site_id: "puneanimal",
          theme: 'light',
          page_title: document.title,
          url: `https://puneanimalliberation.com${location.pathname}`,
          max_shown_comments: 15,
          show_email_subscription: false,
          simple_view: false,
          no_footer: false,
          hide_anonymous: false,
          enable_backlinks: false,
          show_rss_subscription: false,
          show_upvotes: false,
          show_downvotes: false,
        };

        const s = document.createElement("script");
        s.src = "https://comments.puneanimalliberation.com/web/embed.js";
        s.defer = true;
        document.body.appendChild(s);

        // Load comment count
        const counter = document.querySelector(".remark42__counter") as HTMLElement;
        if (counter) {
          const url = counter.dataset.url;
          fetch(`https://comments.puneanimalliberation.com/api/v1/count?site=puneanimal&url=${url}`)
            .then(res => res.json())
            .then(data => {
              const count = data.count || 0;
              counter.textContent = `${count} ${count === 1 ? 'comment' : 'comments'} on ${post.data.title}`;
            })
            .catch(() => {
              counter.textContent = `No comments on ${post.data.title}`;
            });
        }

        // Remove admin controls
        setTimeout(() => {
          const adminButtons = document.querySelectorAll('.remark42__comment-actions button[title*="Hide"], .remark42__comment-actions button[title*="Show"], .remark42__comment-actions button[title*="Delete"], .remark42__comment-actions button[title*="Edit"], .remark42__comment-actions button[title*="Verify"]');
          adminButtons.forEach(btn => {
            (btn as HTMLElement).style.display = 'none';
            (btn as HTMLElement).remove();
          });

          const moderationElements = document.querySelectorAll('.remark42__moderation, .remark42__moderation-panel, .remark42__hidden-comments-notice, .remark42__show-hidden-comments');
          moderationElements.forEach(el => {
            (el as HTMLElement).style.display = 'none';
            (el as HTMLElement).remove();
          });
        }, 2000);
      }

      // Load comments when user scrolls near bottom or clicks comment counter
      window.addEventListener("load", function () {
        const counter = document.querySelector(".remark42__counter") as HTMLElement;
        if (counter) {
          counter.addEventListener("click", loadComments);
        }
        
        // Load comments when scrolling near bottom
        window.addEventListener("scroll", function() {
          if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 1000) {
            loadComments();
          }
        }, { once: true });
      });
    </script>

    <a href="/blog/" class="btn btn--secondary mt-md">&larr; Back to Blog</a>
  </div>
</Layout>
