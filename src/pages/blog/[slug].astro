---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={post.data.title}>
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">{post.data.title}</h1>
    </div>
  </div>

  <div class="post">
    <p class="post__date">{formattedDate}</p>
    <div class="post__body">
      <Content />
    </div>
    <a href="/blog/" class="btn btn--secondary mt-md">&larr; Back to Blog</a>
  </div>
</Layout>
