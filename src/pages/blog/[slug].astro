---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout 
  title={post.data.title}
  description={post.data.description || `Read ${post.data.title} by ${post.data.author || 'Pune Animal Liberation'}`}
  image={post.data.image}
  type="article"
>
  <!-- Structured Data for Article -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "author": {
      "@type": "Organization",
      "name": "Pune Animal Liberation"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Pune Animal Liberation",
      "url": "https://puneanimalliberation.com"
    },
    "description": post.data.description || `Read ${post.data.title} by ${post.data.author || 'Pune Animal Liberation'}`,
    "image": post.data.image ? (post.data.image.startsWith('http') ? post.data.image : `https://puneanimalliberation.com${post.data.image}`) : undefined,
    "url": `https://puneanimalliberation.com${Astro.url.pathname}`,
    "mainEntityOfPage": `https://puneanimalliberation.com${Astro.url.pathname}`
  }, null, 2)} />
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">{post.data.title}</h1>
      <p class="page-header__subtitle">
        {formattedDate}
        {post.data.author && <span> &middot; {post.data.author}</span>}
      </p>
    </div>
  </div>

  <div class="post">
    {
      post.data.image && (
        <img src={post.data.image} alt={post.data.imageAlt || ''} class="post__cover" width="800" height="400" />
      )
    }

    <!-- Article content -->
    <div class="post__body">
      <Content />
    </div>

    <!-- Comment counter -->
    <a
      href="#remark42"
      class="remark42__counter"
      data-url={`https://puneanimalliberation.com${Astro.url.pathname}`}
      aria-label={`Comments on ${post.data.title}`}
    >
      Loading comments...
    </a>

    <!-- Comments -->
    <div id="remark42"></div>

    <script is:inline>
      // Load comments immediately
      window.remark_config = {
        host: "https://comments.puneanimalliberation.com",
        site_id: "puneanimal",
        theme: 'light',
        page_title: document.title,
        url: window.location.origin + window.location.pathname,
        max_shown_comments: 15,
        show_email_subscription: false,
        simple_view: false,
        no_footer: false,
        hide_anonymous: false,
        enable_backlinks: false,
        show_rss_subscription: false,
        show_upvotes: false,
        show_downvotes: false,
      };

      // Load embed script
      (function() {
        var d = document, s = d.createElement('script');
        s.src = 'https://comments.puneanimalliberation.com/web/embed.js';
        s.defer = true;
        (d.head || d.body).appendChild(s);
      })();

      // Update counter when comments load
      window.addEventListener('load', function() {
        const counter = document.querySelector('.remark42__counter');
        if (counter) {
          const url = counter.getAttribute('data-url');
          fetch('https://comments.puneanimalliberation.com/api/v1/count?site=puneanimal&url=' + encodeURIComponent(url))
            .then(function(res) { return res.json(); })
            .then(function(data) {
              const count = data.count || 0;
              counter.textContent = count + (count === 1 ? ' comment' : ' comments');
            })
            .catch(function() {
              counter.textContent = '0 comments';
            });
        }

        // Remove admin controls after comments load
        setTimeout(function() {
          var adminButtons = document.querySelectorAll('.remark42__comment-actions button[title*="Hide"], .remark42__comment-actions button[title*="Show"], .remark42__comment-actions button[title*="Delete"], .remark42__comment-actions button[title*="Edit"], .remark42__comment-actions button[title*="Verify"]');
          adminButtons.forEach(function(btn) {
            btn.style.display = 'none';
            btn.remove();
          });

          var moderationElements = document.querySelectorAll('.remark42__moderation, .remark42__moderation-panel, .remark42__hidden-comments-notice, .remark42__show-hidden-comments');
          moderationElements.forEach(function(el) {
            el.style.display = 'none';
            el.remove();
          });
        }, 2000);
      });
    </script>

    <a href="/blog/" class="btn btn--secondary mt-md">&larr; Back to Blog</a>
  </div>
</Layout>
