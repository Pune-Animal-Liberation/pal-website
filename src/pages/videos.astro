---
import Layout from '../layouts/Layout.astro';

const videos = [
  { language: 'Hindi', label: 'हिंदी', videoId: '6i6XUkuxsEU', thumbnail: 'maxresdefault' },
  { language: 'English', label: 'English', videoId: 'i_9sLUoEEDw', thumbnail: 'maxresdefault' },
  { language: 'Marathi', label: 'मराठी', videoId: 'IqFYHFQVfmI', thumbnail: 'hqdefault' },
];
---

<Layout
  title="3 Minute Movie Challenge"
  description="Watch the Pune Animal Liberation three-minute movie challenge in Hindi, English, and Marathi."
  image={`https://img.youtube.com/vi/${videos[0].videoId}/${videos[0].thumbnail}.jpg`}
  robots="noindex, nofollow"
  bodyClass="video-page"
>
  <div class="video-page__shell">
    <header class="video-page__header">
      <p class="video-page__eyebrow">Pune Animal Liberation presents</p>
      <h1>3 Minute Movie Challenge</h1>
      <p class="video-page__intro">Choose a language to watch.</p>
    </header>

    <section class="video-gallery" aria-label="Three Minute Movie Challenge videos">
      {videos.map((video, index) => (
        <article class="video-card video-card--available">
          <button
            class="video-card__button"
            type="button"
            data-video-id={video.videoId}
            aria-label={`Play ${video.language} video`}
          >
            <span class="video-card__thumbnail">
              <img
                src={`https://img.youtube.com/vi/${video.videoId}/${video.thumbnail}.jpg`}
                alt={`${video.language} Three Minute Movie Challenge thumbnail`}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <span class="video-card__play" aria-hidden="true">▶</span>
              <span class="video-card__language">{video.label}</span>
            </span>
          </button>
        </article>
      ))}
    </section>

    <dialog class="video-dialog" aria-labelledby="video-dialog-title">
      <div class="video-dialog__content">
        <h2 id="video-dialog-title" class="visually-hidden">Playing video</h2>
        <button class="video-dialog__close" type="button" aria-label="Close video">×</button>
        <div class="video-dialog__frame-wrap">
          <iframe
            title="Three Minute Movie Challenge video"
            allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.video-dialog');
  const dialogContent = dialog?.querySelector<HTMLElement>('.video-dialog__content');
  const iframe = dialog?.querySelector<HTMLIFrameElement>('iframe');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.video-dialog__close');

  const closeVideo = () => {
    if (!dialog || !iframe) return;
    iframe.src = '';
    if (document.fullscreenElement) document.exitFullscreen();
    dialog.close();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !dialogContent || !iframe) return;
      const videoId = button.dataset.videoId;
      if (!videoId) return;

      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1`;
      dialog.showModal();

      if (dialogContent.requestFullscreen) {
        dialogContent.requestFullscreen().catch(() => {
          // Fullscreen is not available in every browser or embedded context.
        });
      }
    });
  });

  closeButton?.addEventListener('click', closeVideo);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeVideo();
  });
  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeVideo();
  });
</script>

<style is:global>
  body.video-page {
    background: #000;
    color: #fff;
  }

  body.video-page > .skip-link,
  body.video-page .nav,
  body.video-page .footer {
    display: none;
  }

  body.video-page main {
    min-height: 100vh;
  }

  .video-page__shell {
    min-height: 100vh;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .video-page__header {
    width: min(100%, 1100px);
    margin: 0 auto clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .video-page__eyebrow {
    margin: 0 0 0.75rem;
    color: #c8a15a;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .video-page__header h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .video-page__intro {
    margin: 1rem 0 0;
    color: #9a9a9a;
    font-size: 1rem;
  }

  .video-gallery {
    width: min(100%, 1100px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }

  .video-card {
    min-width: 0;
  }

  .video-card__button {
    width: 100%;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .video-card__thumbnail {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #151515;
  }

  .video-card__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .video-card__button:hover .video-card__thumbnail img,
  .video-card__button:focus-visible .video-card__thumbnail img {
    transform: scale(1.04);
    opacity: 0.72;
  }

  .video-card__button:focus-visible {
    outline: 2px solid #c8a15a;
    outline-offset: 5px;
  }

  .video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    padding-left: 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.62);
    font-size: 1.35rem;
    transform: translate(-50%, -50%);
    transition: background 200ms ease, transform 200ms ease;
  }

  .video-card__button:hover .video-card__play,
  .video-card__button:focus-visible .video-card__play {
    background: #c8a15a;
    color: #000;
    transform: translate(-50%, -50%) scale(1.08);
  }

  .video-card__language,
  .video-card__title {
    display: block;
  }

  .video-card__language {
    position: absolute;
    top: 1rem;
    left: 50%;
    z-index: 1;
    margin: 0;
    color: #c8a15a;
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    transform: translateX(-50%);
  }

  .video-card--coming-soon {
    opacity: 0.72;
  }

  .video-card__thumbnail--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid #292929;
    background: radial-gradient(circle at 50% 35%, #242424 0, #101010 55%, #050505 100%);
  }

  .video-card__placeholder-mark {
    color: #c8a15a;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .video-card__coming-soon-label {
    margin-top: 0.5rem;
    color: #8b8b8b;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .video-dialog {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
  }

  .video-dialog::backdrop {
    background: #000;
  }

  .video-dialog__content {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #000;
  }

  .video-dialog__frame-wrap {
    width: min(100vw, 177.78vh);
    aspect-ratio: 16 / 9;
  }

  .video-dialog iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-dialog__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.7);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .video-dialog__close:hover,
  .video-dialog__close:focus-visible {
    color: #000;
    background: #c8a15a;
  }

  @media (max-width: 760px) {
    .video-page__shell {
      justify-content: flex-start;
      padding-top: 3rem;
    }

    .video-gallery {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }
</style>
