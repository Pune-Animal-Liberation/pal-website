---
import Layout from '../layouts/Layout.astro';

const videos = [
  { language: 'Hindi', label: 'हिंदी', videoId: '6i6XUkuxsEU', thumbnail: 'maxresdefault' },
  { language: 'English', label: 'English', videoId: 'i_9sLUoEEDw', thumbnail: 'maxresdefault' },
  { language: 'Marathi', label: 'मराठी', videoId: 'IqFYHFQVfmI', thumbnail: 'hqdefault' },
];
---

<Layout
  title="3 Minute Movie Challenge"
  description="Watch the Pune Animal Liberation three-minute movie challenge in Hindi, English, and Marathi."
  image={`https://img.youtube.com/vi/${videos[0].videoId}/${videos[0].thumbnail}.jpg`}
  robots="noindex, nofollow"
  bodyClass="video-page"
>
  <div class="video-page__shell">
    <header class="video-page__header">
      <p class="video-page__eyebrow">Pune Animal Liberation presents</p>
      <h1>3 Minute Movie Challenge</h1>
      <p class="video-page__intro">Choose a language to watch.</p>
    </header>

    <section class="video-gallery" aria-label="Three Minute Movie Challenge videos">
      {videos.map((video, index) => (
        <article class="video-card video-card--available">
          <button
            class="video-card__button"
            type="button"
            data-video-id={video.videoId}
            data-video-key={video.language.toLowerCase()}
            aria-label={`Play ${video.language} video`}
          >
            <span class="video-card__thumbnail">
              <img
                src={`https://img.youtube.com/vi/${video.videoId}/${video.thumbnail}.jpg`}
                alt={`${video.language} Three Minute Movie Challenge thumbnail`}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <span class="video-card__play" aria-hidden="true">▶</span>
              <span class="video-card__language">{video.label}</span>
            </span>
          </button>
        </article>
      ))}
      <article class="video-card video-card--local">
        <button
          class="video-card__button"
          type="button"
          data-video-key="kids"
          aria-label="Play Kids video"
          disabled
        >
          <span class="video-card__thumbnail">
            <video data-local-thumbnail="kids" muted playsinline preload="metadata"></video>
            <span class="video-card__play" aria-hidden="true">▶</span>
            <span class="video-card__language">Kids</span>
          </span>
        </button>
      </article>
    </section>

    <section class="offline-controls" aria-labelledby="offline-controls-title">
      <div class="offline-controls__heading">
        <h2 id="offline-controls-title">Offline videos</h2>
        <p>Choose a folder containing <code>english.mp4</code>, <code>hindi.mp4</code>, <code>marathi.mp4</code>, and <code>kids.mp4</code> to play from the tablet.</p>
      </div>
      <div class="offline-picker">
        <label class="visually-hidden" for="video-folder-path">Selected videos folder</label>
        <input
          id="video-folder-path"
          class="offline-picker__path"
          type="text"
          value="No folder selected"
          readonly
          aria-describedby="video-folder-status"
        />
        <button class="offline-picker__button" type="button" id="video-folder-browse">Browse</button>
        <input
          class="visually-hidden"
          id="video-folder-input"
          type="file"
          webkitdirectory
          directory
          multiple
          accept="video/mp4,.mp4"
          tabindex="-1"
        />
      </div>
      <p class="offline-controls__status" id="video-folder-status" aria-live="polite">
        YouTube playback is active. Select a folder to use local files without internet.
      </p>
    </section>

    <dialog class="video-dialog" aria-labelledby="video-dialog-title">
      <div class="video-dialog__content">
        <h2 id="video-dialog-title" class="visually-hidden">Playing video</h2>
        <button class="video-dialog__close" type="button" aria-label="Close video">×</button>
        <div class="video-dialog__frame-wrap">
          <iframe
            hidden
            title="Three Minute Movie Challenge video"
            allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
          <video hidden controls playsinline preload="metadata"></video>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.video-dialog');
  const dialogContent = dialog?.querySelector<HTMLElement>('.video-dialog__content');
  const iframe = dialog?.querySelector<HTMLIFrameElement>('iframe');
  const localVideo = dialog?.querySelector<HTMLVideoElement>('video');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.video-dialog__close');
  const folderInput = document.querySelector<HTMLInputElement>('#video-folder-input');
  const folderBrowseButton = document.querySelector<HTMLButtonElement>('#video-folder-browse');
  const folderPathInput = document.querySelector<HTMLInputElement>('#video-folder-path');
  const folderStatus = document.querySelector<HTMLElement>('#video-folder-status');
  const kidsButton = document.querySelector<HTMLButtonElement>('[data-video-key="kids"]');
  const kidsThumbnail = document.querySelector<HTMLVideoElement>('[data-local-thumbnail="kids"]');
  const localVideoUrls = new Map<string, string>();

  const videoDefinitions = [
    { key: 'english', label: 'English' },
    { key: 'hindi', label: 'Hindi' },
    { key: 'marathi', label: 'Marathi' },
    { key: 'kids', label: 'Kids' },
  ];

  const updateFolderStatus = (files: File[]) => {
    if (!folderPathInput || !folderStatus) return;

    if (files.length === 0) {
      folderPathInput.value = 'No folder selected';
      folderStatus.textContent = 'YouTube playback is active. Select a folder to use local files without internet.';
      return;
    }

    const firstFile = files[0] as File & { webkitRelativePath?: string };
    const folderName = firstFile.webkitRelativePath?.split('/')[0] || 'Selected folder';
    const found = videoDefinitions.filter((video) => localVideoUrls.has(video.key));
    const missing = videoDefinitions.filter((video) => !localVideoUrls.has(video.key));

    folderPathInput.value = folderName;
    folderStatus.textContent = found.length === videoDefinitions.length
      ? 'All four offline videos are ready. They will play from this tablet without internet.'
      : `Found ${found.length} of ${videoDefinitions.length}: ${found.map((video) => video.label).join(', ') || 'none'}. Missing: ${missing.map((video) => `${video.key}.mp4`).join(', ')}. Missing videos will use YouTube.`;
  };

  folderBrowseButton?.addEventListener('click', () => folderInput?.click());
  folderInput?.addEventListener('change', () => {
    localVideoUrls.forEach((url) => URL.revokeObjectURL(url));
    localVideoUrls.clear();
    kidsButton?.setAttribute('disabled', '');
    if (kidsThumbnail) {
      kidsThumbnail.removeAttribute('src');
      kidsThumbnail.load();
    }

    const files = Array.from(folderInput.files ?? []);
    videoDefinitions.forEach((video) => {
      const mp4Files = files.filter((file) => file.name.toLowerCase().endsWith('.mp4'));
      const matchingFile = mp4Files.find((file) => file.name.toLowerCase() === `${video.key}.mp4`)
        ?? mp4Files.find((file) => file.name.toLowerCase().includes(video.key));
      if (matchingFile) localVideoUrls.set(video.key, URL.createObjectURL(matchingFile));
    });

    const kidsUrl = localVideoUrls.get('kids');
    if (kidsUrl && kidsThumbnail) {
      kidsThumbnail.src = kidsUrl;
      kidsButton?.removeAttribute('disabled');
    }

    updateFolderStatus(files);
  });

  const closeVideo = () => {
    if (!dialog || !iframe || !localVideo) return;
    iframe.src = '';
    iframe.hidden = true;
    localVideo.pause();
    localVideo.removeAttribute('src');
    localVideo.load();
    localVideo.hidden = true;
    if (document.fullscreenElement) document.exitFullscreen();
    dialog.close();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-video-key]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !dialogContent || !iframe || !localVideo) return;
      const videoId = button.dataset.videoId;
      const videoKey = button.dataset.videoKey;
      const localVideoUrl = videoKey ? localVideoUrls.get(videoKey) : undefined;
      if (localVideoUrl) {
        iframe.src = '';
        iframe.hidden = true;
        localVideo.src = localVideoUrl;
        localVideo.hidden = false;
      } else if (videoId) {
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1`;
        iframe.hidden = false;
        localVideo.hidden = true;
      } else {
        return;
      }

      dialog.showModal();

      if (localVideoUrl) {
        localVideo.play().catch(() => {
          // The user can start playback with the native controls if autoplay is blocked.
        });
      }

      if (dialogContent.requestFullscreen) {
        dialogContent.requestFullscreen().catch(() => {
          // Fullscreen is not available in every browser or embedded context.
        });
      }
    });
  });

  closeButton?.addEventListener('click', closeVideo);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeVideo();
  });
  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeVideo();
  });
</script>

<style is:global>
  body.video-page {
    background: #000;
    color: #fff;
  }

  body.video-page > .skip-link,
  body.video-page .nav,
  body.video-page .footer {
    display: none;
  }

  body.video-page main {
    min-height: 100vh;
  }

  .video-page__shell {
    min-height: 100vh;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .video-page__header {
    width: min(100%, 1100px);
    margin: 0 auto clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .video-page__eyebrow {
    margin: 0 0 0.75rem;
    color: #c8a15a;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .video-page__header h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .video-page__intro {
    margin: 1rem 0 0;
    color: #9a9a9a;
    font-size: 1rem;
  }

  .offline-controls {
    width: min(100%, 760px);
    margin: clamp(20rem, 47vh, 30rem) auto 0;
    padding: 1rem 1.25rem;
    border: 1px solid #292929;
    background: #0d0d0d;
  }

  .offline-controls__heading h2 {
    margin: 0 0 0.35rem;
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .offline-controls__heading p,
  .offline-controls__status {
    margin: 0;
    color: #9a9a9a;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .offline-controls code {
    color: #d7b873;
    font-size: 0.8rem;
  }

  .offline-picker {
    display: flex;
    gap: 0.75rem;
    margin: 1rem 0 0.65rem;
  }

  .offline-picker__path {
    min-width: 0;
    flex: 1;
    padding: 0.7rem 0.8rem;
    border: 1px solid #3a3a3a;
    border-radius: 0;
    color: #d0d0d0;
    background: #000;
    font: inherit;
    font-size: 0.85rem;
  }

  .offline-picker__button {
    flex: 0 0 auto;
    padding: 0.7rem 1.15rem;
    border: 1px solid #c8a15a;
    border-radius: 0;
    color: #000;
    background: #c8a15a;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .offline-picker__button:hover,
  .offline-picker__button:focus-visible {
    color: #fff;
    background: #8e713c;
  }

  .offline-picker__button:focus-visible,
  .offline-picker__path:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .video-gallery {
    width: min(100%, 1100px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }

  .video-card {
    min-width: 0;
  }

  .video-card__button {
    width: 100%;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .video-card__thumbnail {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #151515;
  }

  .video-card__thumbnail img,
  .video-card__thumbnail > video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .video-card__button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .video-card__button:not(:disabled):hover .video-card__thumbnail img,
  .video-card__button:not(:disabled):hover .video-card__thumbnail > video,
  .video-card__button:focus-visible .video-card__thumbnail img,
  .video-card__button:focus-visible .video-card__thumbnail > video {
    transform: scale(1.04);
    opacity: 0.72;
  }

  .video-card__button:focus-visible {
    outline: 2px solid #c8a15a;
    outline-offset: 5px;
  }

  .video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    padding-left: 0.2rem;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.62);
    font-size: 1.35rem;
    transform: translate(-50%, -50%);
    transition: background 200ms ease, transform 200ms ease;
  }

  .video-card__button:not(:disabled):hover .video-card__play,
  .video-card__button:focus-visible .video-card__play {
    background: #c8a15a;
    color: #000;
    transform: translate(-50%, -50%) scale(1.08);
  }

  .video-card__language {
    display: block;
  }

  .video-card__language {
    position: absolute;
    top: 1rem;
    left: 50%;
    z-index: 1;
    margin: 0;
    color: #c8a15a;
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    transform: translateX(-50%);
  }

  .video-dialog {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
  }

  .video-dialog::backdrop {
    background: #000;
  }

  .video-dialog__content {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: #000;
  }

  .video-dialog__frame-wrap {
    width: min(100vw, 177.78vh);
    aspect-ratio: 16 / 9;
  }

  .video-dialog iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-dialog video {
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
    object-fit: contain;
  }

  .video-dialog__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    color: #fff;
    background: rgba(0, 0, 0, 0.7);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .video-dialog__close:hover,
  .video-dialog__close:focus-visible {
    color: #000;
    background: #c8a15a;
  }

  @media (max-width: 760px) {
    .offline-picker {
      align-items: stretch;
      flex-direction: column;
    }

    .offline-picker__button {
      width: 100%;
    }

    .video-page__shell {
      justify-content: flex-start;
      padding-top: 3rem;
    }

    .video-gallery {
      grid-template-columns: 1fr;
      max-width: 520px;
    }
  }
</style>
