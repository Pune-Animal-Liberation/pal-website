---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');

  return events.map((event) => ({
    params: { slug: event.data.slug ?? event.id },
    props: { event },
  }));
}

type Props = {
  event: CollectionEntry<'events'>;
};

const { event } = Astro.props;
const { Content } = await render(event);

const formattedDate = event.data.date.toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={event.data.title}>
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">{event.data.title}</h1>
    </div>
  </div>

  <div class="post">
    <div class="post__meta-group">
      <p class="post__date">{formattedDate}</p>
      {event.data.time && (
        <p class="post__time">
          <span aria-hidden="true">&#x1F550;</span>
          <span>{event.data.time}</span>
        </p>
      )}
    </div>
    {event.data.location && (
      <div class="post__location-group">
        <p class="post__location">
          <span aria-hidden="true">&#x1F4CD;</span>
          <span>{event.data.location}</span>
        </p>
        {event.data.mapLink && (
          <p class="post__map-link">
            <span aria-hidden="true">&#x1F5FA;</span>
            <a href={event.data.mapLink} target="_blank" rel="noopener noreferrer">View on Map</a>
          </p>
        )}
      </div>
    )}
    {event.data.contactPerson && (
      <p class="post__contact">
        <span aria-hidden="true">&#x1F4D1;</span>
        <span>Contact: {event.data.contactPerson}</span>
      </p>
    )}
    <div class="post__body">
      <Content />
    </div>
    <a href="/events/" class="btn btn--secondary mt-md">&larr; Back to Events</a>
  </div>
</Layout>
