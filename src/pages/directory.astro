---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Directory"
  description="Your quick guide to vegan living in Pune — discover vegan cafés, products, events, and a supportive local community, all in one place."
>
  <div class="page-header">
    <div class="container">
      <h1 class="page-header__title">Directory</h1>
      <p class="page-header__subtitle">
        Your quick guide to vegan living in Pune — discover vegan cafés, products, events, and
        a supportive local community, all in one place. 🌱
      </p>
    </div>
  </div>

  <div class="directory">
    <!-- Start Here -->
    <div class="directory__card">
      <h2>Start Here</h2>
      <p>
        <a href="https://veganindiahub.com/why-go-vegan/" target="_blank" rel="noopener noreferrer" class="dir-link">
          Why go Vegan? →
        </a>
      </p>
    </div>

    <!-- Pune Vegan Food Guide -->
    <div class="directory__card directory__card--food">
      <h2>Pune Vegan Food Guide</h2>
      <ul class="dir-list">
        <li><a href="https://puneveganrestaurants.carrd.co" target="_blank" rel="noopener noreferrer">👉🏻 Pune Vegan Restaurants 🍽️</a></li>
        <li><a href="https://puneveganbakeries.carrd.co" target="_blank" rel="noopener noreferrer">👉🏻 Pune Vegan Bakeries 🎂</a></li>
        <li><a href="https://puneveganicecreams.carrd.co" target="_blank" rel="noopener noreferrer">👉🏻 Pune Vegan Icecreams 🍦</a></li>
      </ul>
    </div>

    <!-- Follow -->
    <div class="directory__card">
      <h2>Follow</h2>
      <ul class="dir-list">
        <li><a href="https://instagram.com/puneanimalliberation" target="_blank" rel="noopener noreferrer">@puneanimalliberation</a></li>
        <li><a href="https://instagram.com/marathivegan" target="_blank" rel="noopener noreferrer">@marathivegan</a></li>
        <li><a href="https://instagram.com/veganwayout" target="_blank" rel="noopener noreferrer">@veganwayout</a></li>
        <li><a href="https://instagram.com/arvindanimalactivist" target="_blank" rel="noopener noreferrer">@arvindanimalactivist</a></li>
      </ul>
    </div>

    <!-- Other Links -->
    <div class="directory__card">
      <h2>Other Links</h2>
      <ul class="dir-list">
        <li><a href="https://veganindiahub.com/recipes" target="_blank" rel="noopener noreferrer">Plant Based Recipes</a></li>
        <li><a href="https://veganindiahub.com/directory/cosmetics/" target="_blank" rel="noopener noreferrer">Vegan Wellness &amp; Beauty</a></li>
        <li><a href="https://veganindiahub.com/directory/household-vegan-items/" target="_blank" rel="noopener noreferrer">Household Vegan Items</a></li>
        <li><a href="https://veganindiahub.com/pets" target="_blank" rel="noopener noreferrer">Vegan Pet Food &amp; Care</a></li>
        <li><a href="https://veganindiahub.com/stores/" target="_blank" rel="noopener noreferrer">Vegan Online Stores</a></li>
        <li><a href="https://nourishyou.in/pages/off-the-shelf-vegan-products-in-india" target="_blank" rel="noopener noreferrer">Already Vegan Products</a></li>
      </ul>
    </div>

    <!-- Health -->
    <div class="directory__card">
      <h2>Health</h2>
      <ul class="dir-list">
        <li><a href="https://sharan-india.org/newsletteremail/vitamin-b12-all-you-need-to-know/" target="_blank" rel="noopener noreferrer">What is Vitamin B12?</a></li>
        <li><a href="https://sharan-india.org/faq/how-can-i-supplement-vitamin-b12/" target="_blank" rel="noopener noreferrer">Vitamin B12 Dosage</a></li>
        <li><a href="https://sharan-india.org/faq/what-are-the-suggested-vitamin-d-supplement-dosages/" target="_blank" rel="noopener noreferrer">Vitamin D Dosage</a></li>
        <li><a href="https://sharan-india.org/faq/if-i-stop-dairy-where-will-i-get-my-calcium-from/" target="_blank" rel="noopener noreferrer">What about Calcium?</a></li>
        <li><a href="https://www.pickuplimes.com/article/the-plate-method-26" target="_blank" rel="noopener noreferrer">The Plate Method</a></li>
        <li><a href="https://www.instagram.com/reel/C-HVK8KICox/" target="_blank" rel="noopener noreferrer">Is Plant Protein Superior?</a></li>
      </ul>
    </div>

    <!-- Plant Based Treaty -->
    <div class="directory__card directory__card--highlight">
      <h2>What is the Plant Based Treaty?</h2>
      <p>
        We are urging individuals, groups, businesses and cities to endorse this call to action
        and put pressure on national governments to negotiate an international Plant Based Treaty
        as a companion to the UNFCCC Paris Agreement.
      </p>
      <p>
        The treaty would put food systems at the heart of combating the climate crisis, aiming to
        halt the widespread degradation of critical ecosystems caused by animal agriculture, to
        promote a shift to more healthy, sustainable plant-based diets and to actively reverse
        damage done to planetary functions, ecosystem services and biodiversity.
      </p>
      <a href="https://plantbasedtreaty.org/" target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
        Please Sign the Plant Based Treaty
      </a>
    </div>
  </div>
</Layout>

<style>
  /* ===== Directory page grid ===== */
  .directory {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--spacing-lg) var(--spacing-sm);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
  }

  .directory__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--spacing-md);
    transition: border-color var(--transition), transform var(--transition);
  }

  .directory__card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .directory__card h2 {
    font-size: var(--font-size-lg);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 2px solid var(--color-accent);
  }

  .directory__card p {
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text);
    font-weight: 100;
    margin-bottom: var(--spacing-sm);
  }

  .directory__card--highlight {
    grid-column: 1 / -1;
    border-left: 4px solid var(--color-accent);
  }

  .directory__card--food {
    border-left: 4px solid var(--color-secondary);
  }

  .directory__card--food h2 {
    color: #5c6b3b;
  }

  .directory__card--highlight h2 {
    border-bottom: none;
  }

  .dir-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .dir-list li {
    margin-bottom: 0.5rem;
  }

  .dir-list a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-base);
    font-weight: 100;
    display: block;
    padding: 0.35rem 0;
    border-left: 3px solid transparent;
    padding-left: 0.75rem;
    transition: color var(--transition), border-color var(--transition);
  }

  .dir-list a:hover {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .dir-link {
    display: inline-block;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 300;
    font-size: var(--font-size-lg);
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color var(--transition);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .dir-link:hover {
    color: var(--color-primary-dark);
    border-bottom-color: var(--color-primary-dark);
  }

  @media (max-width: 768px) {
    .directory {
      grid-template-columns: 1fr;
    }
  }
</style>