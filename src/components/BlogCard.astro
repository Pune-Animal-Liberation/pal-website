---
interface Props {
  title: string;
  date: Date;
  url: string;
  author?: string;
  image?: string;
}

const { title, date, url, author, image } = Astro.props;

const formattedDate = date.toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="card">
  {
    image && (
      <a href={url} tabindex="-1" aria-hidden="true">
        <img src={image} alt="" class="card__image" width="400" height="225" />
      </a>
    )
  }
  <p class="card__meta">
    {formattedDate}
    {author && <span class="card__author"> &middot; {author}</span>}
  </p>
  <h3 class="card__title">
    <a href={url}>{title}</a>
  </h3>
  <a href={url} class="card__link" aria-label={`Read: ${title}`}
    >Read More &rarr;</a
  >
  <a
    href={url}
    class="remark42__counter"
    data-url={`https://puneanimalliberation.com${url}`}
    data-card-url={url}
  >
    Loading comments...
  </a>
</article>

<script define:vars={{ url }}>
  // Load comment count for this card when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    // Use a more specific selector to avoid conflicts
    const counter = document.querySelector(`[data-card-url="${url}"]:not([data-loaded])`);
    if (counter) {
      // Mark as loaded to prevent duplicate processing
      counter.setAttribute('data-loaded', 'true');
      const apiUrl = counter.dataset.url;

      // Add small delay to avoid race conditions
      setTimeout(() => {
        fetch(`https://comments.puneanimalliberation.com/api/v1/count?site=puneanimal&url=${encodeURIComponent(apiUrl)}`)
          .then(res => res.json())
          .then(data => {
            const count = data.count || 0;
            counter.textContent = `${count} ${count === 1 ? 'comment' : 'comments'}`;
          })
          .catch(() => {
            counter.textContent = '0 comments';
          });
      }, Math.random() * 500 + 100); // Random delay between 100-600ms
    }
  });
</script>
