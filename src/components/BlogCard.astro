---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  date: Date;
  author?: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  url: string;
}

const { title, date, author, thumbnail, thumbnailAlt, url } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const formattedDate = date.toLocaleDateString(t('date.format'), {
  year: "numeric",
  month: "long",
  day: "numeric",
});

---

<article class="card">
  {
    thumbnail && (
      <a href={url} tabindex="-1" aria-hidden="true">
        <img src={thumbnail} alt={thumbnailAlt || ''} class="card__image" width="400" height="225" />
      </a>
    )
  }
  <p class="card__meta">
    {formattedDate}
    {author && <span class="card__author"> &middot; {author}</span>}
  </p>
  <h3 class="card__title">
    <a href={url}>{title}</a>
  </h3>
  <a href={url} class="card__link" aria-label={`${t('btn.read_more')}: ${title}`}
    >{t('btn.read_more')} &rarr;</a
  >
</article>
