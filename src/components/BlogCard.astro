---
interface Props {
  title: string;
  date: Date;
  url: string;
  author?: string;
  image?: string;
}

const { title, date, url, author, image } = Astro.props;

const formattedDate = date.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card">
  {image && (
    <a href={url} tabindex="-1" aria-hidden="true">
      <img src={image} alt="" class="card__image" />
    </a>
  )}
  <p class="card__meta">
    {formattedDate}
    {author && <span class="card__author"> &middot; {author}</span>}
  </p>
  <h3 class="card__title">
    <a href={url}>{title}</a>
  </h3>
  <a href={url} class="card__link" aria-label={`Read: ${title}`}>Read More &rarr;</a>
</article>
