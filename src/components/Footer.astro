---
import { getLangFromUrl, useTranslations, getPathWithLang } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="footer__brand">PAL</p>
        <p class="footer__tagline">
          {t('footer.description')}
        </p>
      </div>
      <div>
        <p class="footer__heading">{t('footer.quick_links')}</p>
        <ul class="footer__links">
          <li><a href={getPathWithLang('/', lang)}>{t('nav.home')}</a></li>
          <li><a href={getPathWithLang('/about/', lang)}>{t('nav.about')}</a></li>
          <li><a href={getPathWithLang('/blog/', lang)}>{t('nav.blog')}</a></li>
          <li><a href={getPathWithLang('/events/', lang)}>{t('nav.events')}</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__heading">{t('footer.connect')}</p>
        <ul class="footer__links">
          <li><a href={getPathWithLang('/get-involved/', lang)}>{t('nav.get_involved')}</a></li>
          <li><a href={getPathWithLang('/resources/', lang)}>{t('nav.resources')}</a></li>
          <li><a href={getPathWithLang('/contact/', lang)}>{t('nav.contact')}</a></li>
        </ul>
      </div>
    </div>
    <p class="footer__bottom">
      &copy; {year} {t('footer.copyright')}
    </p>
  </div>
</footer>
