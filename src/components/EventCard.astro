---
interface Props {
  title: string;
  date: Date;
  location?: string;
  url: string;
  status?: 'upcoming' | 'concluded' | 'cancelled' | 'postponed';
  coverImage?: string;
  coverImageAlt?: string;
}

const { title, date, location, url, status, coverImage, coverImageAlt } = Astro.props;

const statusLabels = {
  upcoming: 'Upcoming',
  concluded: 'Concluded',
  cancelled: 'Cancelled',
  postponed: 'Postponed',
};

const formattedDate = date.toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card card--event">
  {coverImage && <img class="card__image" src={coverImage} alt={coverImageAlt ?? ''} loading="lazy" />}
  {status && <p class="card__status">{statusLabels[status]}</p>}
  <p class="card__meta">{formattedDate}</p>
  <h3 class="card__title">
    <a href={url}>{title}</a>
  </h3>
  {location && (
    <p class="card__location">
      <span aria-hidden="true">&#x1F4CD;</span>
      <span>{location}</span>
    </p>
  )}
  <a href={url} class="card__link card__link--event" aria-label={`Event details: ${title}`}>
    Details &rarr;
  </a>
</article>
